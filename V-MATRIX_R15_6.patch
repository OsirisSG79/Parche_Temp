+"""R15 · Persistencia verificada del registro durable de revisiones (ALTA-04).
+
+Prueba obligatoria 9 de la auditoría R14: «Persistencia de revisiones
+simulada en fallo ⇒ el endpoint debe reportar error, nunca éxito».
+
+`video_airbag._guardar_json` llamaba a `escribir_json_seguro(..., lanzar=False)`
+e IGNORABA el `ResultadoPersistencia`: `guardar_revision_video` devolvía la
+revisión como persistida aunque el archivo durable no se hubiera guardado
+(`RETURNED_SUCCESS confirmado 10 2.0` en la reproducción del auditor). La
+política de `aprendizaje_video_airbag` (ErrorPersistenciaAprendizaje) y de
+`maximos_video` (lanzar=True) sí era verificada; aquí se unifica.
+"""
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+from fastapi import HTTPException
+
+import dashboard.backend.app as backend
+import video_airbag
+from utilidades.persistencia import ResultadoPersistencia
+
+CASE_KEY = "PROY|1ST|HT|NOM|1001"
+CLAVE = hashlib.sha256(CASE_KEY.encode("utf-8")).hexdigest()[:16]
+
+
+def _fallo(ruta, data, lanzar=False, compacto=False):
+    return ResultadoPersistencia(guardado=False, destino=Path(ruta),
+                                 intentos=3, error="disco lleno (fallo inyectado)")
+
+
+class _GestorAprendizajeStub:
+    def __init__(self, config=None):
+        pass
+
+    def estado_revision(self, ambito, item_id, inicial):
+        return {"estado": "pendiente", "inicial": inicial}
+
+    def listar_alertas_atendidas(self, *a, **kw):
+        return set()
+
+
+@pytest.fixture
+def entorno(monkeypatch, tmp_path):
+    lote = tmp_path / "Lote"
+    (lote / "CASO1").mkdir(parents=True)
+    video = lote / "CASO1" / "n_DETAIL.AVI"
+    video.write_bytes(b"RIFFdummy")
+    validacion = tmp_path / "validacion_resultados.json"
+    validacion.write_text(json.dumps({
+        "raiz": str(lote),
+        "resultados": [{
+            "nombre": "CASO1", "case_key": CASE_KEY,
+            "ruta": str(lote / "CASO1"), "tipo_st": "1ST", "imagenes": [],
+            "videos": [{"id": "V1", "nombre": "n_DETAIL.AVI", "ruta": str(video),
+                        "ruta_relativa": "CASO1/n_DETAIL.AVI",
+                        "carpeta_video": "CASO1"}],
+        }],
+    }), encoding="utf-8")
+    revisiones = tmp_path / "revisiones_video.json"
+
+    import maximos_video
+
+    monkeypatch.setattr(video_airbag, "RUTA_REVISIONES", revisiones)
+    monkeypatch.setattr(backend, "RUTA_VALIDACION", validacion)
+    monkeypatch.setattr(backend, "RUTA_ESTRUCTURA", tmp_path / "no_existe.json")
+    monkeypatch.setattr(backend, "_cache", {"mtime": None, "datos": None})
+    monkeypatch.setattr(backend, "_pipeline_estado",
+                        copy.deepcopy(backend._pipeline_estado))
+    monkeypatch.setattr(backend, "_pipeline_hilo", None)
+    monkeypatch.setattr(backend, "_pipeline_reserva", None, raising=False)
+    monkeypatch.setattr(backend, "_video_reanalisis_hilo", None)
+    monkeypatch.setattr(backend, "CONFIG", {})
+    monkeypatch.setattr(backend, "GestorAprendizaje", _GestorAprendizajeStub)
+    monkeypatch.setattr(backend, "_regenerar_excel", lambda resultado: None)
+    monkeypatch.setattr(backend, "_resolver_raiz_datos", lambda datos: lote)
+    monkeypatch.setattr(backend, "_resolver_imagen",
+                        lambda ruta, datos, raiz: Path(ruta))
+    monkeypatch.setattr(backend, "_aplicar_consenso_video_a_fila",
+                        lambda fila, consenso: None)
+    monkeypatch.setattr(backend, "_migrar_consensos_video", lambda datos: None)
+    monkeypatch.setattr(backend, "_evento_censurado_video_api", lambda item: False)
+    monkeypatch.setattr(video_airbag, "normalizar_videos_caso",
+                        lambda videos, config: None)
+    monkeypatch.setattr(video_airbag, "consenso_videos",
+                        lambda videos, config: {"tiempo_ms": None, "soporte": 0,
+                                                "estado": "pendiente"})
+    monkeypatch.setattr(maximos_video, "incorporar_maximos", lambda fila: None)
+
+    yield {"lote": lote, "video": video, "validacion": validacion,
+           "revisiones": revisiones, "tmp": tmp_path}
+
+
+def test_guardar_revision_video_lanza_si_la_escritura_falla(entorno, monkeypatch):
+    """Unidad: el helper durable NUNCA devuelve éxito con guardado=False."""
+    monkeypatch.setattr(video_airbag, "escribir_json_seguro", _fallo)
+    with pytest.raises(video_airbag.ErrorPersistenciaRevisiones):
+        video_airbag.guardar_revision_video(
+            entorno["video"], case_key=CASE_KEY, frame_index=None,
+            tiempo_ms=None, estado="pendiente", usuario="tester")
+
+
+def test_endpoint_revision_reporta_error_y_no_exito_si_falla_el_durable(
+        entorno, monkeypatch):
+    """Prueba obligatoria 9: 503 explícito; ni el durable ni el documento cambian."""
+    monkeypatch.setattr(video_airbag, "escribir_json_seguro", _fallo)
+    antes = entorno["validacion"].read_bytes()
+    with pytest.raises(HTTPException) as exc:
+        backend.revisar_video(backend.SolicitudRevisionVideo(
+            prueba_id=CLAVE, video_id="V1", estado="pendiente", usuario="tester"))
+    assert exc.value.status_code == 503
+    assert "no se guardó" in str(exc.value.detail).lower()
+    # El documento de resultados no fue tocado (la revisión no se aplica).
+    assert entorno["validacion"].read_bytes() == antes
+
+
+def test_revision_valida_sigue_guardando_verificado(entorno):
+    """Control: sin fallo inyectado, la revisión se persiste de verdad."""
+    revision = video_airbag.guardar_revision_video(
+        entorno["video"], case_key=CASE_KEY, frame_index=None,
+        tiempo_ms=None, estado="pendiente", usuario="tester")
+    assert revision["estado"] == "pendiente"
+    assert entorno["revisiones"].is_file()
+    datos = json.loads(entorno["revisiones"].read_text(encoding="utf-8"))
+    assert len(datos["revisiones"]) == 1
diff --git a/pruebas/test_v15_10_1_r15_red_segura.cjs b/pruebas/test_v15_10_1_r15_red_segura.cjs
new file mode 100644
index 0000000..5766883
--- /dev/null
+++ b/pruebas/test_v15_10_1_r15_red_segura.cjs
@@ -0,0 +1,110 @@
+/* R15 · Red segura en el frontend (auditoría R14: MEDIA-08, MEDIA-09,
+ * MEDIA-13, BAJA-17 + MEDIA-14 lado cliente).
+ *
+ * Pruebas obligatorias 13 (respuesta antigua no sobrescribe la nueva) y 14
+ * (máximo una solicitud activa de frame por tarjeta), más las correcciones
+ * de 404 por contexto, tooltip duplicado y expected_revision en las
+ * mutaciones de video.
+ *
+ * Parte unidad (red_segura.js) + parte de cableado (app.js/index.html).
+ */
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const red = require(path.resolve(__dirname, '../dashboard/frontend/red_segura.js'));
+
+(async () => {
+  // --- Unidad: sondeo serial nunca solapa (prueba 13, causa raíz MEDIA-08) ---
+  let concurrencia = 0;
+  let maxConcurrencia = 0;
+  let ejecuciones = 0;
+  const puertas = [];
+  const sondeo = red.crearSondeoSerial({
+    intervaloMs: 1,
+    dormir: () => Promise.resolve(),
+    tarea: async () => {
+      concurrencia += 1; ejecuciones += 1;
+      maxConcurrencia = Math.max(maxConcurrencia, concurrencia);
+      await new Promise((resolver) => puertas.push(resolver));
+      concurrencia -= 1;
+    },
+  });
+  sondeo.iniciar();
+  // Mientras la primera tarea no termina, NO debe arrancar otra.
+  await new Promise((r) => setTimeout(r, 20));
+  assert.strictEqual(ejecuciones, 1, 'el sondeo serial solapó peticiones');
+  puertas.shift()();
+  await new Promise((r) => setTimeout(r, 20));
+  assert.strictEqual(ejecuciones, 2, 'el sondeo no reanudó tras terminar la tarea');
+  assert.strictEqual(maxConcurrencia, 1, 'hubo dos tareas en vuelo a la vez');
+  sondeo.detener();
+  puertas.length && puertas.shift()();
+  await new Promise((r) => setTimeout(r, 20));
+  const trasDetener = ejecuciones;
+  await new Promise((r) => setTimeout(r, 20));
+  assert.strictEqual(ejecuciones, trasDetener, 'detener() no cortó el bucle');
+  assert.strictEqual(sondeo.iniciar(), false, 'un sondeo detenido no se reinicia');
+
+  // --- Unidad: guarda de secuencia descarta respuestas antiguas ---
+  const guarda = red.crearGuardaSecuencia();
+  const t1 = guarda.siguiente();
+  const t2 = guarda.siguiente();
+  assert.strictEqual(guarda.esVigente(t1), false, 'respuesta antigua sigue vigente');
+  assert.strictEqual(guarda.esVigente(t2), true);
+
+  // --- Unidad: política 404 explícita (MEDIA-13) ---
+  assert.strictEqual(red.lanzar404({ permitir404: false }), true);
+  assert.strictEqual(red.lanzar404({ permitir404: true }), false);
+  assert.strictEqual(red.lanzar404(undefined), false);
+
+  // --- Cableado en app.js ---
+  const src = fs.readFileSync(path.resolve(__dirname, '../dashboard/frontend/app.js'), 'utf8');
+
+  // MEDIA-08: el intervalo de 1200 ms que solapaba peticiones debe haber
+  // desaparecido del polling de proceso y del listado.
+  assert.ok(!src.includes('setInterval(() => { refrescar(); refrescarReanalisisVideos(); }, 1200)'),
+    'el polling de proceso sigue con setInterval solapable');
+  assert.ok(!/setInterval\(\(\) => \{\s*pedirJSON\(rutaFilas\)/.test(src),
+    'el polling del listado sigue con setInterval solapable');
+  assert.ok(src.includes('crearSondeoSerial'), 'app.js no usa el sondeo serial');
+  assert.ok(src.includes('crearGuardaSecuencia'), 'app.js no usa la guarda de secuencia');
+
+  // MEDIA-13: pedirJSON con política explícita y recursos concretos en modo estricto.
+  assert.ok(src.includes('permitir404'), 'pedirJSON no tiene política explícita de 404');
+  assert.ok(/\/api\/video\/tiempo-frame[^;]*permitir404: false/s.test(src),
+    'tiempo-frame sigue convirtiendo 404 en null silencioso');
+
+  // MEDIA-09: frame principal con fetch + AbortController + Blob URL (prueba 14).
+  const efecto = src.slice(src.indexOf('const rutaFrameSolicitada'), src.indexOf('const proporcion ='));
+  assert.ok(efecto.includes('AbortController'), 'el frame no aborta la descarga anterior');
+  assert.ok(efecto.includes('createObjectURL'), 'el frame no usa Blob URL');
+  assert.ok(efecto.includes('fetch(rutaFrameSolicitada'), 'el frame no se descarga con fetch cancelable');
+  assert.ok(!efecto.includes('img.src = rutaFrameSolicitada'),
+    'el frame sigue cargando directo por URL sin cancelación');
+
+  // MEDIA-14 (cliente): expected_revision en las mutaciones de video.
+  for (const endpoint of ['/api/video/revision', '/api/video/maximo', '/api/video/zona-aprendizaje', '/api/video/zona-revertir']) {
+    const re = new RegExp(`enviarJSON\\("${endpoint.replace('/', '\\/')}", \\{[^}]*expected_revision`, 's');
+    const cuerpos = src.split(`enviarJSON("${endpoint}"`).length - 1;
+    assert.ok(cuerpos >= 1, `falta el POST a ${endpoint}`);
+    const trozos = src.split(`enviarJSON("${endpoint}"`).slice(1);
+    for (const trozo of trozos) {
+      assert.ok(trozo.slice(0, 700).includes('expected_revision'),
+        `un POST a ${endpoint} no envía expected_revision`);
+    }
+    void re;
+  }
+  assert.ok(src.includes('revision_documento'), 'el cliente no sigue la revisión del documento');
+
+  // BAJA-17: title duplicado del botón «Esta zona + este cuadro = apertura».
+  assert.ok(!src.includes('title="Guarda esta región como zona de interés y el cuadro actual como primer cuadro de apertura"'),
+    'el title genérico duplicado sigue sobrescribiendo el tooltip de evento censurado');
+
+  // index.html carga el módulo antes que app.js.
+  const idx = fs.readFileSync(path.resolve(__dirname, '../dashboard/frontend/index.html'), 'utf8');
+  assert.ok(idx.includes('red_segura.js'), 'index.html no carga red_segura.js');
+  assert.ok(idx.indexOf('red_segura.js') < idx.indexOf('app.js'),
+    'red_segura.js debe cargarse antes que app.js');
+
+  console.log('OK R15 red segura: sondeo serial + secuencia + 404 explícito + AbortController + CAS + tooltip');
+})().catch((e) => { console.error(e.message); process.exit(1); });
diff --git a/pruebas/test_v15_10_1_r15_revisiones.py b/pruebas/test_v15_10_1_r15_revisiones.py
