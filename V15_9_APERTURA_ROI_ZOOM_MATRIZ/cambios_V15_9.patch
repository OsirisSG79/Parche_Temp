+   posiciones vacantes y zoom/lupa de inspección del video. */
+.dialogo-rangos {
+  width: min(560px, 94vw);
+  max-height: 88vh;
+  overflow: auto;
+  padding: 18px 20px;
+  border-radius: 14px;
+  background: var(--superficie, #101827);
+  border: 1px solid var(--borde, #334155);
+  box-shadow: 0 18px 48px rgba(0, 0, 0, .45);
+}
+.dialogo-rangos-vista-previa { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0; }
+.dialogo-rangos-vista-previa .chip { color: #0b1220; font-weight: 700; }
+.dialogo-rangos-campos { display: flex; flex-wrap: wrap; gap: 12px; margin: 10px 0; }
+.dialogo-rangos-campos label { display: flex; flex-direction: column; gap: 4px; font-size: 12.5px; }
+.dialogo-rangos-campos .campo { width: 150px; }
+.dialogo-rangos-combinacion { margin: 6px 0; }
+.dialogo-rangos-guardar { display: flex; align-items: center; gap: 8px; margin: 8px 0; font-size: 12.5px; }
+.dialogo-rangos-acciones { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 14px; }
+
+/* Matriz: posición esperada sin caso (gris tenue, distinto del gris de valor
+   no confiable) y grupo «Sin clasificar» navegable al Listado. */
+.matriz-celda-vacante {
+  background: #d4d4d8;
+  border: 1px dashed #a1a1aa;
+  border-radius: 6px;
+  opacity: .85;
+}
+.leyenda-apertura .matriz-celda-vacante,
+.matriz-celda-vacante { display: inline-block; }
+.matriz-columna-cupos { display: block; opacity: .75; font-size: 10.5px; }
+.matriz-sin-clasificar-lista { display: flex; flex-wrap: wrap; gap: 6px; }
+.matriz-celda-fuera { min-width: 44px; min-height: 29px; border: 1px solid var(--borde, #334155); }
+
+/* Zoom de inspección general (independiente del modo ROI) y lupa temporal. */
+.video-inspector-barra {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 6px;
+  margin-bottom: 8px;
+}
+.video-inspector-barra .boton-compacto { min-height: 28px; padding: 4px 9px; font-size: 11.5px; }
+.video-inspector-overlays {
+  display: inline-flex;
+  gap: 10px;
+  margin-left: auto;
+  font-size: 11.5px;
+  opacity: .92;
+}
+.video-inspector-overlays label { display: inline-flex; align-items: center; gap: 4px; cursor: pointer; }
+.video-inspector-marco {
+  width: 100%;
+  overflow: auto;
+  max-height: 68vh;
+  border-radius: 10px;
+  background: #050b14;
