+.video-inspector-marco:fullscreen { max-height: none; border-radius: 0; background: #000; }
+.video-lupa-temporal {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+  align-items: flex-start;
+  margin-top: 10px;
